generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  files      File[]
  notes      Note[]
  tasks      Task[]
  contacts   Contact[]
  events     CalendarEvent[]
  reminders  Reminder[]
  passwords  Password[]
  settings   UserSettings?
  notifications AppNotification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── File System ──────────────────────────────────────────────
model File {
  id         String   @id @default(cuid())
  userId     String
  fsId       String   // virtual FS node id
  name       String
  type       String   // 'file' | 'folder'
  parentFsId String?
  content    String?  @db.Text
  size       Int?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fsId])
  @@index([userId, parentFsId])
}

// ── Notes ────────────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  color     String   @default("#1e1e2e")
  folderId  String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Tasks / Todo ─────────────────────────────────────────────
model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  completed   Boolean   @default(false)
  priority    String    @default("medium") // low | medium | high
  dueDate     DateTime?
  listId      String?
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Contacts ─────────────────────────────────────────────────
model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  address   String?
  company   String?
  website   String?
  avatar    String?
  notes     String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Calendar Events ──────────────────────────────────────────
model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  color       String   @default("#7C4DFF")
  location    String?
  recurring   String?  // 'daily' | 'weekly' | 'monthly' | null
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Reminders ────────────────────────────────────────────────
model Reminder {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  remindAt    DateTime
  isComplete  Boolean  @default(false)
  priority    String   @default("medium")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Password Manager ─────────────────────────────────────────
model Password {
  id        String   @id @default(cuid())
  userId    String
  siteName  String
  siteUrl   String?
  username  String
  password  String   // encrypted in app layer
  notes     String?
  category  String   @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── User Settings ────────────────────────────────────────────
model UserSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  themeMode    String   @default("dark")
  accentColor  String   @default("#7C4DFF")
  wallpaper    String   @default("/wallpapers/default.jpg")
  dockPinned   String[] @default([])
  desktopIcons String   @db.Text @default("{}")
  fontSize     String   @default("medium")
  animations   Boolean  @default(true)
  notifications Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Notifications ────────────────────────────────────────────
model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  appId     String
  appName   String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
