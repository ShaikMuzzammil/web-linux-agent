# ── Neon PostgreSQL ───────────────────────────────────────────────
# Get these from console.neon.tech → Connection Details

# Pooled connection (used by Prisma at runtime)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Direct connection (used by Prisma for migrations / db push)
DIRECT_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── NextAuth ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-here

# Your deployment URL (no trailing slash)
# Dev:  http://localhost:3000
# Prod: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Optional: AI Chat ─────────────────────────────────────────────
# Get from console.anthropic.com
# If not set, Chat app will show a "No API key" message
ANTHROPIC_API_KEY=sk-ant-xxx
