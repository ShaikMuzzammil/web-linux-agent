# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get these from https://neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────────────────────
# NEXTAUTH_URL: set to your production domain on Vercel (or omit - trustHost handles it)
# NEXTAUTH_SECRET: generate with: openssl rand -base64 32
NEXTAUTH_URL="https://your-project.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── Email via Resend (Optional) ─────────────────────────────────────────────
RESEND_API_KEY=""
CONTACT_EMAIL="your@email.com"

# ── Claude AI Chat (Optional) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=""
