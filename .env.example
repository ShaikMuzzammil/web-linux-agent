# ============================================================
#  Web Linux Agent — Environment Variables
#  Copy this file to .env.local and fill in your values
# ============================================================

# ── DATABASE (Neon PostgreSQL) ────────────────────────────
# Get from: https://neon.tech → New Project → Connection Details
# "Pooled" connection (used by Prisma for queries)
DATABASE_URL="postgresql://USER:PASS@HOST/DBNAME?sslmode=require&pgbouncer=true"
# "Direct" connection (used by Prisma Migrate / prisma db push)
DIRECT_URL="postgresql://USER:PASS@HOST/DBNAME?sslmode=require"

# ── NEXTAUTH ──────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-64-char-secret"
# Production URL (leave blank for localhost)
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"

# ── OAUTH (Optional — enables GitHub / Google login) ─────
# GitHub → https://github.com/settings/developers → New OAuth App
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google → https://console.cloud.google.com → APIs & Services → Credentials
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── RESEND (Email) ────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Must be a verified domain in your Resend account
# For testing, use: onboarding@resend.dev
RESEND_FROM_EMAIL="portfolio@yourdomain.com"
